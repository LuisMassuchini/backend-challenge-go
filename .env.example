# Variaveis de ambiente do ambiente local.
#
# Copie para `.env` e ajuste se precisar. O Compose ja tem default para cada uma
# delas, entao o ambiente sobe sem este arquivo; ele existe para que os valores
# que a aplicacao le sejam os mesmos que o Compose provisiona, e para que a
# documentacao e o ambiente nao divirjam.
#
#   cp .env.example .env
#
# Nenhum valor aqui e segredo real. Sao credenciais de ambiente local de teste,
# versionadas de proposito, e o Compose as usa como estao.

# --- Aplicacao -------------------------------------------------------------

# Endereco de escuta do wager-service dentro do Compose.
WAGER_HTTP_ADDRESS=:8080
WAGER_HTTP_READ_TIMEOUT=5s
WAGER_HTTP_WRITE_TIMEOUT=10s
WAGER_HTTP_IDLE_TIMEOUT=60s
WAGER_HTTP_SHUTDOWN_TIMEOUT=20s
WAGER_LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------

WAGER_POSTGRES_USER=wager
WAGER_POSTGRES_PASSWORD=wager
WAGER_POSTGRES_DB=wager
WAGER_POSTGRES_PORT=5432

# DSN usada pela aplicacao e pelos testes de integracao, com o host trocado pelo
# nome do servico quando a aplicacao roda dentro do Compose.
WAGER_POSTGRES_DSN=postgres://wager:wager@localhost:5432/wager?sslmode=disable

# --- SQS (LocalStack) ------------------------------------------------------

WAGER_SQS_ENDPOINT=http://localhost:4566
WAGER_SQS_PORT=4566
WAGER_AWS_REGION=us-east-1
WAGER_AWS_ACCESS_KEY_ID=test
WAGER_AWS_SECRET_ACCESS_KEY=test
WAGER_LOCALSTACK_DEBUG=0

# --- OIDC (Keycloak) -------------------------------------------------------

WAGER_KEYCLOAK_PORT=8081
WAGER_KEYCLOAK_ADMIN=admin
WAGER_KEYCLOAK_ADMIN_PASSWORD=admin

WAGER_OIDC_ISSUER=http://localhost:8081/realms/wager
WAGER_OIDC_AUDIENCE=wager-service

# Identidades de teste. O segredo do cliente e declarado no realm
# (deploy/keycloak/wager-realm.json) para ser igual em qualquer maquina.
WAGER_OIDC_PROVIDER_A_CLIENT_ID=provider-a
WAGER_OIDC_PROVIDER_A_CLIENT_SECRET=provider-a-secret
WAGER_OIDC_PROVIDER_B_CLIENT_ID=provider-b
WAGER_OIDC_PROVIDER_B_CLIENT_SECRET=provider-b-secret
WAGER_OIDC_INTERNAL_CLIENT_ID=wager-service
WAGER_OIDC_INTERNAL_CLIENT_SECRET=wager-service-secret
